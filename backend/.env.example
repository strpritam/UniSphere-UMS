PORT=4000
JWT_SECRET=replace-with-strong-secret
# For local dev: http://localhost:5173,http://localhost:8080
# For Vercel: https://your-frontend-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/progress_portal?retryWrites=true&w=majority
MONGODB_DB_NAME=progress_portal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-gmail@gmail.com
